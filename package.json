{
  "name": "jev-rerank",
  "version": "0.5.1",
  "description": "Drop-in rerank API served by Jev: speaks the Cohere, Jina and Voyage /rerank request and response shapes so existing tools switch by changing a URL.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    }
  },
  "bin": {
    "jev-rerank": "./bin/jev-rerank-server.mjs",
    "jev-rerank-server": "./bin/jev-rerank-server.mjs"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "demo": "node examples/demo.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "start": "node bin/jev-rerank-server.mjs",
    "live-smoke": "node scripts/live-smoke.mjs",
    "benchmark": "node scripts/benchmark-scifact.mjs",
    "benchmark:offline": "node scripts/benchmark-scifact.mjs --offline",
    "test:cohere": "node scripts/verify-cohere-python.mjs",
    "test:frameworks": "node scripts/verify-frameworks-python.mjs",
    "release:check": "npm run check && npm run typecheck && npm test && npm run demo && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/jev-rerank-server.git"
  },
  "bugs": {
    "url": "https://github.com/gbesse/jev-rerank-server/issues"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "typescript": "5.9.3"
  }
}
